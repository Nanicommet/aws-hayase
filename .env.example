# Public port bind. 127.0.0.1 = private (use with Caddy). 0.0.0.0 = open (testing only).
APP_BIND=127.0.0.1
APP_PORT=8080

# Admin token (Authorization: Bearer ...). install.sh generates one if .env is missing.
API_TOKEN=
# Optional key for /hayase/* routes (x-hayase-key header or ?key=). Leave empty for open + rate-limited.
HAYASE_KEY=

# Web player (/watch) + /api/*: languages searched by default, adult sources (off by default), parallel source calls.
DEFAULT_LANGS=en,all
ALLOW_NSFW=0
SEARCH_CONCURRENCY=4

# Hayase bridge: converted episodes are cached on disk (oldest deleted first) and the first request waits this long for a conversion.
CACHE_MAX_GB=5
PREPARE_WAIT_SEC=90

# HTTPS: point a DNS A record at this server, set DOMAIN, then: docker compose --profile https up -d
DOMAIN=

# Optional comma-separated indexer URLs (tried in order = failover).
SUBTITLE_INDEXER_URL=
NZB_INDEXER_URL=

# Pinning (recommended once a build works): tag/commit and image tag.
M_EXT_REF=
FLARESOLVERR_TAG=latest
FLARESOLVERR_LOG_LEVEL=info
TZ=Africa/Tunis

# Managed by ./warp.sh (leave as is): proxy settings for the runtime and FlareSolverr.
JAVA_OPTS=-Dcom.sun.security.enableAIAcaIssuers=true
FLARE_PROXY=
